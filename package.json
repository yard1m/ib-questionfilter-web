{
  "name": "ib-questionfilter-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:corpus-pdfs": "node scripts/check-corpus-pdfs.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "dev:local": "node scripts/copy-pdfjs-assets.mjs && VITE_LOCAL_CORPUS=1 vite --mode local-corpus"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
